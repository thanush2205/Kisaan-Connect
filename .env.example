# KisaanConnect Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=your_secure_session_secret_key_here

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/kisaanconnect

# Email Configuration (Nodemailer for Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-specific-password
SUPPORT_EMAIL=your-email@gmail.com

# Firebase Push Notifications
FIREBASE_PROJECT_ID=kisaan-connect-fe4aa
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Cloudinary CDN Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
